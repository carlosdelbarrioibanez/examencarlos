package ejercicio4;

import java.util.Scanner;

public class Ejercicio4 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("Ingrese un número entero de 5 cifras:");
		int numero = sc.nextInt();
		
		// Verificar que sea un número de 5 cifras
		if (numero < 10000 || numero > 99999) {
			System.out.println("Error: El número debe tener exactamente 5 cifras.");
			sc.close();
			return;
		}
		
		// MÉTODO 1: Usando división de enteros
		System.out.println("\n--- Método 1: División de enteros ---");
		System.out.println("Cifras del número " + numero + ":");
		
		int temp = numero;
		int[] cifras = new int[5];
		
		// Extraer cada cifra usando módulo y división
		for (int i = 4; i >= 0; i--) {
			cifras[i] = temp % 10;
			temp = temp / 10;
		}
		
		// Mostrar cifras desde el principio
		for (int i = 0; i < 5; i++) {
			System.out.println("Cifra " + (i + 1) + ": " + cifras[i]);
		}
		
		// MÉTODO 2: Usando String y métodos de String
		System.out.println("\n--- Método 2: Usando String ---");
		String numeroStr = String.valueOf(numero);
		System.out.println("Cifras del número " + numero + ":");
		
		for (int i = 0; i < numeroStr.length(); i++) {
			char c = numeroStr.charAt(i);
			System.out.println("Cifra " + (i + 1) + ": " + c);
		}
		
		sc.close();
	}

}